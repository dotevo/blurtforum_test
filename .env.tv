# Loaded ONLY by `npm run dev:tv` (vite --mode tv) -- never by a normal
# `npm run dev` or `npm run build`. Forces isTVPlatform() to true so the
# device-profiles picker/PIN-pad/admin screens can be tested with a
# keyboard's arrow keys in a regular desktop browser, without needing a real
# Android TV device or a native build. See src/modules/native/platform-info.ts.
VITE_FORCE_TV=true
